<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="15dp"
    android:paddingTop="14dp">

    <ImageView
        android:id="@+id/imgLimitIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_background"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_currency"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLimitName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_bold"
        android:maxLines="1"
        android:textColor="?attr/budgetTextColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toStartOf="@id/tvLimitAmount"
        app:layout_constraintStart_toEndOf="@id/imgLimitIcon"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Groceries" />

    <TextView
        android:id="@+id/tvLimitAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:textColor="?attr/budgetTextColor"
        android:textSize="15sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvLimitName"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="€120.00 of €200.00" />

    <ProgressBar
        android:id="@+id/limitProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/limit_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgLimitIcon"
        app:layout_constraintTop_toBottomOf="@id/tvLimitName" />

    <TextView
        android:id="@+id/tvLimitStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/roboto_regular"
        android:textColor="?attr/budgetTextColor"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgLimitIcon"
        app:layout_constraintTop_toBottomOf="@id/limitProgress"
        tools:text="€80.00 left. Plenty of wiggle room!" />
</androidx.constraintlayout.widget.ConstraintLayout>
